# The generators and their drift checks compare bytes, so checkouts must stay LF
# on every OS; core.autocrlf on Windows otherwise rewrites them to CRLF.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
